# ─── Required for real AI generation ─────────────────────────────
# Server-only OpenRouter key. Never expose to the client.
# Local: copy this file → .env
#
# Vercel (важно): задай ОДНУ из переменных в Project → Settings → Env:
#   NUXT_OPENROUTER_API_KEY=sk-or-...   ← предпочтительно (Nuxt runtimeConfig)
#   OPENROUTER_API_KEY=sk-or-...        ← тоже ок (runtime read)
# После добавления: Redeploy без Build Cache.
OPENROUTER_API_KEY=
# NUXT_OPENROUTER_API_KEY=

# ─── Public site URL (production) ────────────────────────────────
# Used as OpenRouter HTTP-Referer. Example: https://your-app.vercel.app
NUXT_PUBLIC_SITE_URL=
# Alias also accepted:
# SITE_URL=

# ─── Model fallbacks (if client does not send a model id) ─────────
# Allowlist lives in shared/llmModels.ts — only those ids work.
PLUS_MODEL=google/gemini-2.5-flash
PRO_MODEL=anthropic/claude-sonnet-5

# ─── Optional runtime (hosting) ───────────────────────────────────
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# Windows-only debug: force PowerShell transport for OpenRouter
# OPENROUTER_TRANSPORT=powershell
